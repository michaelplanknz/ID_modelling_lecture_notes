scale_color_brewer("Time series",palette = "Dark2")+
coord_cartesian(xlim=c(as.Date("2025-01-01"), as.Date("2025-06-01")))+
geom_hline(yintercept = 1, linetype="dashed")+
xlab("Date")+
ylab("Reproduction number")
