#####################################################################################################################################################
# 6. Perform analyses in 'real-time' using:
#    1) infections
#    2) cases
#    3) hospitalisations
#    4) deaths
#####################################################################################################################################################
# Using only the data up to 1 March refit the models from part 4 and 5
# Fit to infections, cases, hospitalisations and deaths
# accounting for and not accounting for delay distributions
################################################################################
# 6.a To complete
################################################################################
# Fit a model estimating Rt to each time-series (up to 1 March)
# with and without delay distributions (8 models).
df2 <- df1[df1$date<=as.Date("2025-03-01"),]
mar_model1 <- epinow(
data = data.frame(date=df2$date, confirm=df2$incidence),
generation_time = gt_opts(gamma_distribution),
delays = delay_opts(Fixed(0)),
stan = stan_opts(cores = 4,
samples = 2500,
warmup = 500),
forecast = forecast_opts(horizon=0),
rt = rt_opts(rw=1)
)
saveRDS(mar_model1, 'mar_model_infections.rds')
mar_model2 <- epinow(
data = data.frame(date=df2$date, confirm=df2$cases),
generation_time = gt_opts(gamma_distribution),
delays = delay_opts(Fixed(0)),
stan = stan_opts(cores = 4,
samples = 2500,
warmup = 500),
forecast = forecast_opts(horizon=0),
rt = rt_opts(rw=1)
)
saveRDS(mar_model2, 'mar_model_cases.rds')
mar_model3 <- epinow(
data = data.frame(date=df2$date, confirm=df2$hospitalisations),
generation_time = gt_opts(gamma_distribution),
delays = delay_opts(Fixed(0)),
stan = stan_opts(cores = 4,
samples = 2500,
warmup = 500),
forecast = forecast_opts(horizon=0),
rt = rt_opts(rw=1)
)
saveRDS(mar_model3, 'mar_model_hospitalisations.rds')
mar_model4 <- epinow(
data = data.frame(date=df2$date, confirm=df2$deaths),
generation_time = gt_opts(gamma_distribution),
delays = delay_opts(Fixed(0)),
stan = stan_opts(cores = 4,
samples = 2500,
warmup = 500),
forecast = forecast_opts(horizon=0),
rt = rt_opts(rw=1)
)
saveRDS(mar_model4, 'mar_model_deaths.rds')
mar_model2_delay <- epinow(
data = data.frame(date=df2$date, confirm=df2$cases),
generation_time = gt_opts(gamma_distribution),
delays = delay_opts(case_delay),
stan = stan_opts(cores = 4,
samples = 2500,
warmup = 500),
forecast = forecast_opts(horizon=0),
rt = rt_opts(rw=1)
)
saveRDS(mar_model2_delay, 'mar_model_cases_delay.rds')
mar_model3_delay <- epinow(
data = data.frame(date=df2$date, confirm=df2$hospitalisations),
generation_time = gt_opts(gamma_distribution),
delays = delay_opts(hosp_delay),
stan = stan_opts(cores = 4,
samples = 2500,
warmup = 500),
forecast = forecast_opts(horizon=0),
rt = rt_opts(rw=1)
)
saveRDS(mar_model3_delay, 'mar_model_hospitalisations_delay.rds')
mar_model4_delay <- epinow(
data = data.frame(date=df2$date, confirm=df2$deaths),
generation_time = gt_opts(gamma_distribution),
delays = delay_opts(death_delay),
stan = stan_opts(cores = 4,
samples = 2500,
warmup = 500),
forecast = forecast_opts(horizon=0),
rt = rt_opts(rw=1)
)
saveRDS(mar_model4_delay, 'mar_model_deaths_delay.rds')
####### Pre-fitted models #########
# Confirm code above is correct and runs, before loading pre-fitted models
mar_model1 <- readRDS('mar_model_infections.rds')
mar_model2 <- readRDS('mar_model_cases.rds') # model fit to cases without delay
mar_model3 <- readRDS('mar_model_hospitalisations.rds') # model fit to hospitalisations without delay
mar_model4<- readRDS('mar_model_deaths.rds') # model fit to deaths without delay
mar_model2_delay <- readRDS('mar_model_cases_delay.rds') # model fit to cases with delay
mar_model3_delay <- readRDS('mar_model_hospitalisations_delay.rds') # model fit to hospitalisations with delay
mar_model4_delay <- readRDS('mar_model_deaths_delay.rds') # model fit to deaths with delay
################################################################################
# 6.b To complete
################################################################################
# Produce a plot comparing R estimates made using each of the four different time series with and without delays
# Compare it to your previous plots from 4.c and 5.b
mar_summary1 <- summary(mar_model1, type = 'parameters')
mar_summary2 <- summary(mar_model2, type = 'parameters')
mar_summary3 <- summary(mar_model3, type = 'parameters')
mar_summary4 <- summary(mar_model4, type = 'parameters')
mar_summary2_delay <- summary(mar_model2_delay, type = 'parameters')
mar_summary3_delay <- summary(mar_model3_delay, type = 'parameters')
mar_summary4_delay <- summary(mar_model4_delay, type = 'parameters')
plt6b_1 <- ggplot()+
geom_line(data = mar_summary1[mar_summary1$variable=="R",], aes(x=date, y=median, col='Infections'))+
geom_ribbon(data = mar_summary1[mar_summary1$variable=="R",], aes(x=date, y=median, ymin=lower_50, ymax=upper_50,  fill='Infections'), alpha=0.2)+
geom_ribbon(data = mar_summary1[mar_summary1$variable=="R",], aes(x=date, y=median, ymin=lower_90, ymax=upper_90,  fill='Infections'), alpha=0.2)+
geom_line(data = mar_summary2[mar_summary2$variable=="R",], aes(x=date, y=median, col='Cases'))+
geom_ribbon(data = mar_summary2[mar_summary2$variable=="R",], aes(x=date, y=median, ymin=lower_50, ymax=upper_50,  fill='Cases'), alpha=0.2)+
geom_ribbon(data = mar_summary2[mar_summary2$variable=="R",], aes(x=date, y=median, ymin=lower_90, ymax=upper_90,  fill='Cases'), alpha=0.2)+
geom_line(data = mar_summary3[mar_summary3$variable=="R",], aes(x=date, y=median, col='Hospitalisations'))+
geom_ribbon(data = mar_summary3[mar_summary3$variable=="R",], aes(x=date, y=median, ymin=lower_50, ymax=upper_50,  fill='Hospitalisations'), alpha=0.2)+
geom_ribbon(data = mar_summary3[mar_summary3$variable=="R",], aes(x=date, y=median, ymin=lower_90, ymax=upper_90,  fill='Hospitalisations'), alpha=0.2)+
geom_line(data = mar_summary4[mar_summary4$variable=="R",], aes(x=date, y=median, col='Deaths'))+
