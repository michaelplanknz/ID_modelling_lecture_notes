library(ggplot2)
library(patchwork)
# Values of R0 to run
R0_vec = c(1.1, 3)
# Number of age groups
na = 5
# Number of iterations to do
nIts = 1000
# Index of dominant eigenvalue (largest absolute value)
eig <- eigen(K)
i <- which.max(Mod(eig$values))
# Dominant eigenvalue
lambda_dom <- eig$values[i]
# Corresponding eigenvector
v_dom <- eig$vectors[, i]
v_dom = v_dom/sum(v_dom)
age_groups <- c("1", "2", "3", "4", "5")
pl = list()
ql = list()
leg_loc = c("top", "none")
for (jj in 1:length(R0_vec)) {
R0 = R0_vec[jj]
Kn = R0/lambda_dom * K
# Populatio size vector (na equally sized groups)
N = rep(1/na, na)
# Initial guess for final size vector z and equilibrium susceptible pop S
FSH = 1-1/R0
z = rep(1-1/R0, na)
NS =rep(1/na * (1-1/R0), na)
# Iterate final size and endemic equilibrium equations
for (ii in 1:nIts) {
FSH = 1 - exp(-R0*FSH)
z = 1 - exp(-t(Kn) %*% z)
M <- sweep(Kn, 1, 1-NS/N, "*")
NS = M %*% NS
}
print(R0)
print(v_dom)
z = as.vector(z)
print(z)
ns= as.vector(NS/N)
print(ns)
df <- data.frame(
Category = rep(age_groups, 2),
Value = c(v_dom*sum(z), z),
Group = rep(c("Dominant eigenvector", "Final size"), each = length(age_groups))
)
pl[[jj]] = ggplot(df, aes(x = Category, y = Value, fill = Group)) +
geom_bar(stat = "identity", position = "dodge") +
geom_hline(yintercept = FSH, linetype = "dashed", color = "red", size = 1) +
labs(x = "Age group", y = "Fraction of group")
theme(legend.position = leg_loc[jj])
df <- data.frame(
Category = rep(age_groups, 2),
Value = c(v_dom*sum(ns), ns),
Group = rep(c("Dominant eigenvector", "Equilibrium non-susceptible"), each = length(age_groups))
)
ql[[jj]] = ggplot(df, aes(x = Category, y = Value, fill = Group)) +
geom_bar(stat = "identity", position = "dodge") +
geom_hline(yintercept = 1-1/R0, linetype = "dashed", color = "red", size = 1) +
labs(x = "Age group", y = "Fraction of group")
theme(legend.position = leg_loc[jj])
}
